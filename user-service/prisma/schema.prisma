datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id         BigInt   @id @default(autoincrement())
  name       String
  age        Int
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("students")
}
